{
  "manifest_version": 3,
  "name": "Hate Speech Blur",
  "version": "1.0",
  "description": "Detect and blur hate speech on any website.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5050/*",
    "http://localhost:5050/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["backend/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
